# .env.example — Sao chép thành .env rồi điền giá trị thật.
# CHỈ tên biến + giá trị mẫu; KHÔNG để mật khẩu thật vào file này.
# Backend web KHÔNG đọc file .env (không dùng dotenv) — đặt các biến này
# trong môi trường khi chạy (hoặc systemd EnvironmentFile khi deploy).
# Xem README.md để biết từng biến dùng ở đâu.

# --- Web portal (web/server/server.js) ---
DATABASE_URL=postgres://muweb:CHANGE_ME@127.0.0.1:5432/muss20web
MUWEB_PORT=18082
MUWEB_HOST=127.0.0.1
ADMIN_LOGINS=admin

# --- Accounts API (server/accounts/register-api.js) ---
# Dùng DATABASE_URL ở trên; nếu không đặt, dùng các biến OPENMU_PG* sau:
# OPENMU_PGHOST=127.0.0.1
# OPENMU_PGPORT=5432
# OPENMU_PGDATABASE=muss20web
# OPENMU_PGUSER=postgres
# OPENMU_PGPASSWORD=CHANGE_ME
# REGISTER_API_HOST=127.0.0.1
# REGISTER_API_PORT=18794

# --- Bridge (server/bridge/bridge.js) ---
# BRIDGE_PORT=18793
# BRIDGE_HOST=127.0.0.1
# OPENMU_HOST=127.0.0.1
# OPENMU_CS_PORT=44416
# BRIDGE_LOGIN_XOR3=off
