# MU web portal - https://mu-web.example.com/
# Trang tinh do nginx phuc vu truc tiep; /api/ proxy ve backend node 127.0.0.1:18082.
# Chung chi Let's Encrypt se do certbot gan them (giong mau mu-play).
server {
    listen 80;
    server_name mu-web.example.com;

    root /opt/mu-web/public;
    index index.html;

    location /.well-known/acme-challenge/ { root /srv/mu; }

    location /api/ {
        proxy_pass http://127.0.0.1:18082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
