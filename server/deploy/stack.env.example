# stack.env.example — sao chép thành stack.env trên VPS rồi điền giá trị thật.
# TUYỆT ĐỐI không commit/đưa mật khẩu thật vào file mẫu này.

# --- Thư mục trên VPS ---
STACK_DIR=/opt/muss20-web
OPENMU_DIR=/opt/muss20-web/openmu/src/Startup/bin/Release
DOTNET_BIN=/opt/muss20-web/dotnet/dotnet
CLIENT_DIR=/opt/muss20-web/client

# --- Cổng MỚI (tránh các cổng mulucdia đang park: 18080/18792/44406/55901/8899) ---
# Cầu nối WS (chỉ loopback; nginx/front-proxy đứng trước)
BRIDGE_PORT=18793
BRIDGE_HOST=127.0.0.1
# Mặt tiền tĩnh + proxy /mu (chỉ loopback; nginx đứng trước)
FRONT_PORT=18081
FRONT_HOST=127.0.0.1

# --- OpenMU trên VPS (phải cấu hình lại trong OpenMU — xem RUNBOOK §3) ---
# Đề xuất: CS GMO 44415 / CS Open Source Client 44416,
# GS 45911..45916 (OSC dùng 45912/45914/45916), Chat 45990.
OPENMU_HOST=127.0.0.1
OPENMU_CS_PORT=44416

# --- Công tắc login (mặc định TẮT; chỉ bật khi lát client thật chứng minh
#     client gửi account/password dạng plain — xem BRIDGE-2A-REPORT) ---
BRIDGE_LOGIN_XOR3=off

# --- PostgreSQL cho stack này ---
# Mật khẩu nằm trong ConnectionSettings.xml của OpenMU trên VPS (chmod 600),
# KHÔNG để ở đây. Web portal dùng CHUNG database này (xem web/.env.example),
# nhưng với role riêng (muweb) — xem web/deploy/setup-db.sql.
OPENMU_DB_NAME=muss20web
